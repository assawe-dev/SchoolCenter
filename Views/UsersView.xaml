<UserControl x:Class="UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة حسابات المستخدمين وصلاحيات الشاشات" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="إضافة مستخدمين جدد وتخصيص صلاحيات الوصول بدقة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="btnAddNewUser" Content="+ جديد" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddNewUser_Click" />
            </Grid>
        </Border>

        <!-- Main Grid + Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid Panel -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="قائمة مستخدمي المنظومة" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}" />

                    <DataGrid Grid.Row="1" x:Name="dgUsers" Style="{StaticResource ModernDataGridStyle}" SelectionChanged="dgUsers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المستخدم" Binding="{Binding UserID}" Width="90" />
                            <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*" />
                            <DataGridTextColumn Header="الدور / الصلاحية" Binding="{Binding Role}" Width="130" />
                            <DataGridTextColumn Header="حالة الحساب" Binding="{Binding StatusText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Form Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtFormTitle" Text="إضافة مستخدم جديد" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="اسم المستخدم *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,12" TabIndex="1" />

                        <TextBlock Text="كلمة المرور *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBoxStyle}" Height="36" Margin="0,0,0,12" TabIndex="2" />

                        <TextBlock Text="الدور / المسمى الوظيفي" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="cmbRole" Style="{StaticResource ModernComboBoxStyle}" Height="36" SelectedIndex="0" Margin="0,0,0,12" TabIndex="3">
                            <ComboBoxItem Content="Admin (مدير نظام)" />
                            <ComboBoxItem Content="Accountant (محاسب / موظف)" />
                        </ComboBox>

                        <CheckBox x:Name="chkIsActive" Content="الحساب مفعل ونشط" IsChecked="True" FontSize="13" FontWeight="Bold" Margin="0,0,0,16" TabIndex="4" />

                        <!-- Permissions Frame -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="صلاحيات الوصول للشاشات والوظائف:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                                <CheckBox x:Name="chkCanManageStudents" Content="إدارة سجل الطلاب" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="chkCanManageCourses" Content="إدارة سجل الدورات" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="chkCanAssignDues" Content="تسجيل المستحقات والديون" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="chkCanReceivePayments" Content="سندات القبض وحركة الخزينة" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="chkCanViewReports" Content="عرض تقارير الأرصدة والديون" IsChecked="False" Margin="0,0,0,8" />
                                <CheckBox x:Name="chkCanManageUsers" Content="إدارة المستخدمين والصلاحيات" IsChecked="False" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSaveUser" Grid.Column="0" Content="✓ حفظ المستخدم" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="btnSaveUser_Click" TabIndex="5" />
                            <Button x:Name="btnCancelEdit" Grid.Column="1" Content="↻ جديد" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="btnCancelEdit_Click" TabIndex="6" />
                        </Grid>

                        <Button x:Name="btnDeleteUser" Content="× حذف المستخدم" Style="{StaticResource DangerButtonStyle}" Margin="0,12,0,0" Click="btnDeleteUser_Click" Visibility="Collapsed" TabIndex="7" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
