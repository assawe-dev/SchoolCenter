<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منظومة إدارة المركز التعليمي - تسجيل الدخول"
        Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource ArabicFont}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Brand Panel -->
        <Border Grid.Column="0" Background="{StaticResource DarkNavyBrush}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="100" Height="100" CornerRadius="50" Background="#1E293B" Margin="0,0,0,24" HorizontalAlignment="Center">
                        <TextBlock Text="🏫" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="txtBrandTitle" Text="منظومة مركز الدورات التعليمية" FontSize="22" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="نظام إدارة الطلاب والحسابات والخزينة" FontSize="14" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,32" />

                    <Border Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="اتصال آمن وقاعدة بيانات محمية" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="إصدار 2.0 - Visual Studio 2015 WPF Edition" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Login Form Panel -->
        <Grid Grid.Column="1" Margin="48,40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="أدخل اسم المستخدم وكلمة المرور للمتابعة" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,32" />

                <!-- Notification message -->
                <Border x:Name="pnlError" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,20" Visibility="Collapsed">
                    <TextBlock x:Name="txtErrorMessage" Text="اسم المستخدم أو كلمة المرور غير صحيحة" Foreground="#991B1B" FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- Username -->
                <TextBlock Text="اسم المستخدم" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBoxStyle}" Height="38" Margin="0,0,0,20" Text="admin" TabIndex="1" />

                <!-- Password -->
                <TextBlock Text="كلمة المرور" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBoxStyle}" Height="38" Margin="0,0,0,28" KeyDown="txtPassword_KeyDown" TabIndex="2" />

                <!-- Login Button -->
                <Button x:Name="btnLogin" Content="✓ تسجيل الدخول" Style="{StaticResource PrimaryButtonStyle}" Height="42" Click="btnLogin_Click" IsDefault="True" TabIndex="3" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
