<UserControl x:Class="SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             Loaded="UserControl_Loaded">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,20">
                <StackPanel x:Name="pnlSettings">
                    <TextBlock Text="إعدادات المنظومة وهوية المركز" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="تعديل اسم المركز الشعار الافتراضي الذي يظهر في أعلى القوائم والتقارير" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

                    <!-- Center Name -->
                    <TextBlock Text="اسم المركز / المؤسسة التعليمية *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="txtCenterName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,24" TabIndex="1" />

                    <!-- Center Logo Section -->
                    <TextBlock Text="شعار المركز (Logo)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Logo Preview -->
                            <Border Grid.Column="0" Width="100" Height="100" CornerRadius="8" Background="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="txtLogoPlaceholder" Text="🏫" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="imgLogoPreview" Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="رفع صورة الشعار بصيغة PNG أو JPG" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnUploadLogo" Content="+ اختيار شعار" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnUploadLogo_Click" />
                                    <Button x:Name="btnClearLogo" Content="× إزالة الشعار" Style="{StaticResource SecondaryButtonStyle}" Click="btnClearLogo_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Save Button -->
                    <Button x:Name="btnSaveSettings" Content="✓ حفظ الإعدادات" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" Click="btnSaveSettings_Click" TabIndex="2" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>