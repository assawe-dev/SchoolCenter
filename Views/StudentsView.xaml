<UserControl x:Class="StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBoxStyle}" Width="320" Height="38" TextChanged="txtSearch_TextChanged" ToolTip="بحث بالاسم أو هاتف ولي الأمر" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="btnShowStatement" Content="... كشف حساب" Style="{StaticResource InfoButtonStyle}" Margin="0,0,12,0" Click="btnShowStatement_Click" />
                <Button Grid.Column="2" x:Name="btnAddNewStudent" Content="+ جديد" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddNewStudent_Click" />
            </Grid>
        </Border>

        <!-- Main Content Area: Left DataGrid, Right Add/Edit Form Overlay / Side Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="colForm" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid Panel -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="قائمة الطلاب المسجلين" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}" />

                    <DataGrid Grid.Row="1" x:Name="dgStudents" Style="{StaticResource ModernDataGridStyle}" SelectionChanged="dgStudents_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الطالب" Binding="{Binding StudentID}" Width="90" />
                            <DataGridTextColumn Header="اسم الطالب" Binding="{Binding StudentName}" Width="*" />
                            <DataGridTextColumn Header="ولي الأمر" Binding="{Binding GuardianName}" Width="140" />
                            <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding ParentPhone}" Width="120" />
                            <DataGridTextColumn Header="الرصيد المتبقي" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="120" />
                            <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding RegistrationDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Student Add / Edit Form Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlStudentForm">
                        <TextBlock x:Name="txtFormTitle" Text="إضافة طالب جديد" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="اسم الطالب بالكامل *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="txtStudentName" Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,14" TabIndex="1" />

                        <TextBlock Text="اسم ولي الأمر *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="txtGuardianName" Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,14" TabIndex="2" />

                        <TextBlock Text="رقم هاتف ولي الأمر *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="txtParentPhone" Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,14" TabIndex="3" />

                        <TextBlock Text="ملاحظات" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBoxStyle}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" TabIndex="4" />

                        <!-- Opening Balance Section (only active for new student) -->
                        <Border x:Name="pnlOpeningBalance" Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="الرصيد الافتتاحي السابق (إن وجد)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="المبلغ" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox x:Name="txtOpeningBalanceAmount" Style="{StaticResource ModernTextBoxStyle}" Height="34" Text="0.00" TabIndex="5" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="نوع الرصيد" FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="cmbBalanceType" Style="{StaticResource ModernComboBoxStyle}" Height="34" SelectedIndex="0" TabIndex="6">
                                            <ComboBoxItem Content="مدين (عليه)" />
                                            <ComboBoxItem Content="دائن (له)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSaveStudent" Grid.Column="0" Content="✓ حفظ الطالب" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="btnSaveStudent_Click" TabIndex="7" />
                            <Button x:Name="btnCancelEdit" Grid.Column="1" Content="↻ جديد" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="btnCancelEdit_Click" TabIndex="8" />
                        </Grid>

                        <Button x:Name="btnDeleteStudent" Content="× حذف الطالب" Style="{StaticResource DangerButtonStyle}" Margin="0,12,0,0" Click="btnDeleteStudent_Click" Visibility="Collapsed" TabIndex="9" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
