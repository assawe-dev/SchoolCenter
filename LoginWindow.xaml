<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - مركز التدريب"
        Height="580" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#0F172A">

    <Window.Resources>
        <Style TargetType="Button" x:Key="NumpadBtnStyle">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="#1E3A8A" CornerRadius="4" Grid.Row="0" Margin="0,0,0,15" Padding="8">
                <TextBlock FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Text="نظام إدارة مركز التدريب والدورات"/>
            </Border>

            <!-- Inputs -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#2563EB" CornerRadius="6" Grid.Column="0" Height="80" Margin="0,0,10,0">
                    <TextBlock FontSize="36" Foreground="White" HorizontalAlignment="Center" Text="🔒" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,0,0,3" Text="اسم المستخدم"/>
                    <TextBox Background="#0F172A" BorderBrush="#475569" BorderThickness="1" Foreground="White" Height="30" Padding="5,0" VerticalContentAlignment="Center" x:Name="TxtUsername" GotFocus="InputControl_GotFocus"/>

                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,6,0,3" Text="كلمة السر"/>
                    <PasswordBox Background="#0F172A" BorderBrush="#475569" BorderThickness="1" Foreground="White" Height="30" Padding="5,0" VerticalContentAlignment="Center" x:Name="TxtPassword" GotFocus="InputControl_GotFocus"/>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Background="#2563EB" BorderThickness="0" Click="BtnLogin_Click" Content="🔑  تسجيل الدخول" FontWeight="Bold" Foreground="White" Grid.Column="0" Height="36"/>
                <Button Background="#DC2626" BorderThickness="0" Click="BtnExit_Click" Content="❌  خروج" FontWeight="Bold" Foreground="White" Grid.Column="2" Height="36"/>
            </Grid>

            <!-- Numpad -->
            <UniformGrid Columns="3" Grid.Row="3" Rows="4">
                <Button Click="Numpad_Click" Content="1" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="2" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="3" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="4" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="5" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="6" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="7" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="8" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="9" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Click="Numpad_Click" Content="0" Style="{StaticResource NumpadBtnStyle}"/>
                <Button Background="#475569" BorderThickness="0" Click="BtnClear_Click" Content="C" FontSize="18" FontWeight="Bold" Foreground="White" Margin="2" Focusable="False"/>
                <Button Background="#16A34A" BorderThickness="0" Click="BtnLogin_Click" Content="ENTER" FontSize="13" FontWeight="Bold" Foreground="White" Margin="2" Focusable="False"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
