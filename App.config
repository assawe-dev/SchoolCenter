<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>
    <connectionStrings>
        <add name="DefaultConnection" connectionString="Server=.\SQLEXPRESS;Database=SchoolCenterDB;Integrated Security=True;Connect Timeout=15;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="CenterName" value="منظومة مركز الدورات التعليمية" />
    </appSettings>
</configuration>
