<Window x:Class="AccountStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="كشف حساب تفصيلي للطالب"
        Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource ArabicFont}"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="txtStudentTitle" Text="كشف حساب الطالب: " FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="عرض التسلسل الزمني لجميع الحركات المالية والرصيد المتبقي التراكمي" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Summary Cards Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Required (Debit) -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المطلوب (مدين)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="txtTotalDebit" Text="0.00 د.ل" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Total Paid (Credit) -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="إجمالي المدفوع (دائن)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="txtTotalCredit" Text="0.00 د.ل" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Final Balance -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="الرصيد المتبقي النهائي" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="txtFinalBalance" Text="0.00 د.ل" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid Statement -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="dgStatement" Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاريخ الحركة" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TranslatedType}" Width="140" />
                    <DataGridTextColumn Header="البيان / ملاحظات" Binding="{Binding Notes}" Width="*" />
                    <DataGridTextColumn Header="المطلوب (مدين)" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120" />
                    <DataGridTextColumn Header="المدفوع (دائن)" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120" />
                    <DataGridTextColumn Header="الرصيد التراكمي" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="130" />
                    <DataGridTextColumn Header="الموظف" Binding="{Binding Username}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="إغلاق Window ✖" Style="{StaticResource SecondaryButtonStyle}" Width="140" Click="btnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
