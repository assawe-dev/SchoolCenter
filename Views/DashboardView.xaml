<UserControl x:Class="DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Metric Stat Cards Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Students -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الطلاب المسجلين" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="txtTotalStudents" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                        <TextBlock Text="👨‍🎓" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Treasury Balance -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رصيد الخزينة الحالي" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="txtTreasuryBalance" Text="0.00 د.ل" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#ECFDF5" VerticalAlignment="Center">
                        <TextBlock Text="💵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Total Debts -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الديون المستحقة" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="txtTotalDebts" Text="0.00 د.ل" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#FEF2F2" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Total Courses -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الدورات المتاحة" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="txtTotalCourses" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#F3E8FF" VerticalAlignment="Center">
                        <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Body: Recent Operations DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="آخر العمليات المالية والمعاملات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="عرض أحدث الحركة المباشرة في النظام" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="btnRefresh" Content="↻ تحديث" Style="{StaticResource SecondaryButtonStyle}" Click="btnRefresh_Click" Padding="12,6" FontSize="12" />
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgRecentTransactions" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الحركة" Binding="{Binding TransactionID}" Width="90" />
                        <DataGridTextColumn Header="اسم الطالب" Binding="{Binding StudentName}" Width="*" />
                        <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TranslatedType}" Width="140" />
                        <DataGridTextColumn Header="المبلغ مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120" />
                        <DataGridTextColumn Header="المبلغ دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120" />
                        <DataGridTextColumn Header="تاريخ الحركة" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                        <DataGridTextColumn Header="الموظف المسؤول" Binding="{Binding Username}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
