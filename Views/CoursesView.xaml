<UserControl x:Class="CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBoxStyle}" Width="320" Height="38" TextChanged="txtSearch_TextChanged" ToolTip="بحث باسم الدورة..." />
                </StackPanel>

                <Button Grid.Column="1" x:Name="btnAddNewCourse" Content="+ جديد" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddNewCourse_Click" />
            </Grid>
        </Border>

        <!-- Main Content Area: DataGrid + Form Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid Panel -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="سجل الدورات التعليمية المتاحة" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{StaticResource TextPrimaryBrush}" />

                    <DataGrid Grid.Row="1" x:Name="dgCourses" Style="{StaticResource ModernDataGridStyle}" SelectionChanged="dgCourses_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الدورة" Binding="{Binding CourseID}" Width="100" />
                            <DataGridTextColumn Header="اسم الدورة التعليمية" Binding="{Binding CourseName}" Width="*" />
                            <DataGridTextColumn Header="تلفة الدورة (د.ل)" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Add/Edit Form Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtFormTitle" Text="إضافة دورة جديدة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="اسم الدورة التعليمية *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtCourseName" Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,16" TabIndex="1" />

                    <TextBlock Text="تكلفة / سعر الدورة (د.ل) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtCourseCost" Style="{StaticResource ModernTextBoxStyle}" Height="36" Text="0.00" Margin="0,0,0,24" TabIndex="2" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSaveCourse" Grid.Column="0" Content="✓ حفظ الدورة" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="btnSaveCourse_Click" TabIndex="3" />
                        <Button x:Name="btnCancelEdit" Grid.Column="1" Content="↻ جديد" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="btnCancelEdit_Click" TabIndex="4" />
                    </Grid>

                    <Button x:Name="btnDeleteCourse" Content="× حذف الدورة" Style="{StaticResource DangerButtonStyle}" Margin="0,16,0,0" Click="btnDeleteCourse_Click" Visibility="Collapsed" TabIndex="5" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
