<UserControl x:Class="AcademicAffairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Module Title -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🎓" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="قسم الشؤون الدراسية والتعليمية" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="إدارة الطلاب، المواد والمقررات الدراسية، وقوائم التسجيل في الدورات" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Background="#F3E8FF" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock Text="وحدة العمليات الأكاديمية" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" />
                </Border>
            </Grid>
        </Border>

        <!-- Cards Grid Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="3" Margin="-10">
                <!-- Card 1: Comprehensive Student List -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnComprehensiveStudentList_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#EFF6FF">
                                <TextBlock Text="👨‍🎓" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="شؤون الطلاب" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف الطلبة (كشف متكامل)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="إدارة السجل الشامل للطلاب، إضافة طلاب جدد، وتحديث بيانات التواصل والأرصدة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="فتح السجل ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 2: Courses / Subjects -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnCourses_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#F3E8FF">
                                <TextBlock Text="📚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="المقررات والدورات" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="المواد الدراسية والدورات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="دليل المواد والقرارات التعليمية، أسماء المحاضرين، وتكاليف كل مادة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="دليل المواد ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 3: Students with Courses List -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnStudentsWithCourses_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#FEF3C7">
                                <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="تسجيل الكورسات" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف الطلبة مع المواد" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="ربط وتسجيل الطلاب في المواد الدراسية وحساب التكاليف والمستحقات المترتبة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="سجل التسجيلات ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>