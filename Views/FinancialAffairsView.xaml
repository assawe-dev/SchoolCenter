<UserControl x:Class="FinancialAffairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Module Title -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🏛️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="قسم الشؤون المالية والحسابات" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="إدارة الحركة المالية، سندات القبض والصرف، وكشوفات الحسابات المباشرة" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock Text="وحدة العمليات المالية" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Cards Grid Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="3" Margin="-10">
                <!-- Card 1: Treasury Statement -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnTreasuryStatement_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#ECFDF5">
                                <TextBlock Text="💵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الخزينة الرئيسية" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف حساب الخزينة" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="عرض التسلسل الزمني لجميع الإيداعات والمقبوضات والرصيد النقدي المتوفر بالخزينة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="عرض الدفتر ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 2: Student Account Statement -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnStudentStatement_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#EFF6FF">
                                <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="حسابات الطلاب" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف حساب طالب" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="استعلام واستعراض كشف الحساب التفصيلي بالديون والمسددات لأي طالب." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="كشف الحساب ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 3: Receipt Vouchers List -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnReceiptVouchersList_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#FEF3C7">
                                <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="سجل المقبوضات" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف سندات القبض" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="استعراض وطباعة سجل سندات المقبوضات والعمليات المستلمة من الطلاب." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="عرض السندات ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 4: Payment Vouchers List -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnPaymentVouchersList_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#E0F2FE">
                                <TextBlock Text="📤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="سجل المدفوعات" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="كشف سندات الصرف" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="سجل المبالغ والمصروفات المسحوبة وسندات الصرف الصادرة من النظام." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="عرض الكشف ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 5: New Receipt Voucher -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnNewReceiptVoucher_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#DCFCE7">
                                <TextBlock Text="🟢" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إضافة قبض" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="سند قبض جديد" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="تحصيل المبالغ والرسوم الدراسية من طالب وإصدار سند إيداع نقدي بالخزينة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="إنشاء سند ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Card 6: New Payment Voucher -->
                <Button Style="{StaticResource ModuleCardButtonStyle}" Click="btnNewPaymentVoucher_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#FEE2E2">
                                <TextBlock Text="🔴" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إضافة صرف" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="سند صرف جديد" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="إصدار سند صرف وسحب مالي مباشر من الخزينة لتغطية المصروفات والتكاليف." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="إنشاء سند ←" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>